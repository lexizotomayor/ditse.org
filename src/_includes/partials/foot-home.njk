{%- from "partials/wordmark.njk" import wordmark -%}
<footer class="foot">
  <div class="foot-art">
    <img class="engraving" src="/assets/ditse-boat.png" alt="" aria-hidden="true" loading="lazy" width="1182" height="912">
    <span class="name vtext" aria-hidden="true">ditse</span>
    <div class="words">
      <span class="redbar" aria-hidden="true"></span>
      <p>My field notes: dispatches on Philippine history, culture and personal experiences.</p>
      <a class="label-link" href="#top"><span class="tick" aria-hidden="true"></span>back to top</a>
    </div>
  </div>
  <div class="foot-mark" aria-hidden="true">{{ wordmark(boat=false) }}</div>
  <div class="foot-links">
    <div class="row">
      <nav aria-label="Site">
        <a href="/about/">about</a>
        <a href="/contact/">contact</a>
        <a href="/privacy/">privacy</a>
      </nav>
      <span class="copy">{{ site.copyright }}</span>
      {% include "partials/emblem.njk" %}
    </div>
  </div>
</footer>
{% set barsClass = "bars--end" %}{% include "partials/bars.njk" %}
